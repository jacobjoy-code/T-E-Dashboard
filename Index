function drawH(s,W,H,sp){
  const fmt=sp.fmt||(v=>v),L=sp.labels,n=L.length,ser=sp.series;
  const tot=new Array(n).fill(0),neg=new Array(n).fill(0);ser.forEach(x=>x.data.forEach((v,i)=>{if(v>0)tot[i]+=v;else if(v<0)neg[i]+=v;}));
