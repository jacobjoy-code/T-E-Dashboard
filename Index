// ===== TRAVEL APPROVALS =====
function rTa(){
  const tj=TIX;let tot=0,prior=0,q3=0,q3n=0,q3a=0,openN=0,openA=0,unr=0,out=0;for(const j of tj){tot+=TA.total[j];prior+=TA.prior_air[j];q3a+=TA.q3_air[j];q3n+=TA.q3_nonair[j];openN+=TA.open_nonair[j];openA+=TA.open_air[j];unr+=TA.exp_unraised[j];out+=TA.nonair[j]*(1-TA.q3share[j]);}
  q3=q3a+q3n;const incurred=q3-openN-openA;
  const trav=IDX.filter(i=>TRAVX.has(TX.x[i])&&TX.a[i]>0);const taE=new Set(tj.map(j=>TA.e[j]));let noTa=0;const noTaE=new Map();for(const i of trav)if(!taE.has(TX.e[i])){noTa+=TX.a[i];noTaE.set(TX.e[i],(noTaE.get(TX.e[i])||[]).concat(i));}
  let lk=0;for(const i of IDX)if(TX.lk[i]&&TX.d[i]<=LC)lk+=TX.a[i];
  const acc=incurred>0?lk/incurred:null;
  document.getElementById('taKpis').innerHTML=stat('Approved travel',$k(tot),int(tj.length)+' approvals, '+int(taE.size)+' travellers')+stat('Lands in Q3',$k(q3),'After removing last-quarter airfare and November days','var(--navy)')+stat('Already incurred',$k(incurred),'Estimate for trip days and bookings to '+dL(LC),'var(--teal)')+stat('Open commit',$k(openN+openA),$k(openN)+' trip costs, '+$k(openA)+' unbooked airfare','var(--purple)')+stat('Not yet approved',$k(unr),'Expected trip costs still to be approved','#B490F0')+stat('Estimate accuracy',acc==null?'–':pc(acc),'Actual trip spend vs the approved estimate so far',acc>1.15||acc<0.85?'var(--orange)':'var(--green)');
  const twItems=[{label:'Approved travel',v:tot,kind:'total',color:'#032D60'},{label:'Airfare booked last quarter',v:-prior,kind:'delta',color:'#8E9CAD',note:'Approvals raised before Aug 1. Their airfare was expensed in Q2.'},{label:'Trip days after '+dL(QD-1),v:-out,kind:'delta',color:'#C9C9C9',note:'Hotel and other costs for days that fall in Q4'},{label:'Lands in Q3',v:q3,kind:'total',color:'#0176D3'},{label:'Already incurred',v:-incurred,kind:'delta',color:'#06A59A',note:'Airfare booked in Q3 plus trip costs for days to '+dL(LC)},{label:'Open commit',v:openN+openA,kind:'total',color:'#7526E3'}];
