    sv('rect',{x:xa,y:Yc(i)-hh/2,width:Math.max(1,xb-xa),height:hh,fill:gradOf(s,sp.colorAt?sp.colorAt(x,i):x.color),rx:2},g);}));
  if(sp.valueLabels)L.forEach((l,i)=>{const t=sv('text',{x:X(accP[i])+5,y:Yc(i)+4,fill:'#444'},g);t.textContent=sp.valueLabels(i);});
