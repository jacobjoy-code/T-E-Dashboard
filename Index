function wireMessages(){
  document.getElementById('rlist').addEventListener('change',e=>{const cb=e.target.closest('input[type=checkbox]');if(!cb)return;if(!addSel(cb.dataset.n,cb.checked))cb.checked=false;paintMessages();schedulePreview();});
  document.getElementById('msgFilters').addEventListener('click',e=>{const b=e.target.closest('button[data-f]');if(!b)return;MS.filter=b.dataset.f;paintMessages();});
  let qt;document.getElementById('msgQ').addEventListener('input',e=>{clearTimeout(qt);qt=setTimeout(()=>{MS.q=e.target.value.trim().toLowerCase();paintList();},150);});
  document.getElementById('selAttn').onclick=()=>{if(!MS.ctx)return;let skipped=0;MS.ctx.recipients.filter(needsAttn).forEach(r=>{if(MS.sel.size<MAX_SEL)MS.sel.add(r.name);else skipped++;});paintMessages();schedulePreview();if(skipped)alert('Selected the first '+MAX_SEL+'. '+skipped+' more need attention; send them in another message.');};
  document.getElementById('selNone').onclick=()=>{MS.sel.clear();paintMessages();schedulePreview();};
  document.getElementById('tplgrid').addEventListener('change',e=>{const r=e.target.closest('input[name=tpl]');if(!r)return;MS.tpl=r.value;paintMessages();schedulePreview();});
  document.getElementById('msgNote').addEventListener('input',()=>{document.getElementById('noteCount').textContent=document.getElementById('msgNote').value.length;clearTimeout(MS.timer);MS.timer=setTimeout(()=>{paintMessages();loadPreview();},350);});
  document.getElementById('pPrev').onclick=()=>{if(MS.pi>0){MS.pi--;showItem();}};
  document.getElementById('pNext').onclick=()=>{if(MS.pi<MS.items.length-1){MS.pi++;showItem();}};
  document.getElementById('sendBtn').onclick=openConfirm;
  document.getElementById('scrim').addEventListener('click',e=>{if(e.target.id==='scrim')closeModal();});
}
// reconciliation line on each page: the page total must equal the sum of the view
function tieSet(id,master,parts){const el=document.getElementById('tie-'+id);if(!el)return;const d=Math.abs(master-parts);el.className='tie'+(d>1?' warn':'');el.innerHTML=d<=1?'<b>✓</b> Reconciles to the view total: <b>'+$f(master)+'</b> across '+int(IDX.length)+' expense lines':'<b>⚠</b> Differs from the view total by '+$f(d)+'. Please report this.';}
function grpSum(ix,kf){let s=0;for(const g of grp(ix,kf).values())s+=g.a;return s;}
function ovWrap(){rOverview();tieSet('overview',sum(IDX),grpSum(IDX,i=>TX.ow[i]));}
function lvWrap(){rLeaders();tieSet('leaders',sum(IDX),grpSum(IDX,i=>TX.ld[i]));}
function pplWrap(){rPeople();tieSet('people',sum(IDX),grpSum(IDX,i=>TX.e[i]));}
function catWrap(){rCats();tieSet('cats',sum(IDX),grpSum(IDX,i=>TX.x[i]));}
// keyboard: 1-9 switch pages, / search, Esc closes panels
document.addEventListener('keydown',e=>{const tag=(e.target&&e.target.tagName)||'';if(/INPUT|TEXTAREA|SELECT/.test(tag)){if(e.key==='Escape'){document.activeElement.blur();}return;}
  if(e.key==='Escape'){closeModal();document.getElementById('drawer').classList.remove('open');return;}
  if(e.key==='/'){e.preventDefault();document.getElementById('more').classList.add('open');document.getElementById('f_q').focus();return;}
  const tabs=Array.from(document.querySelectorAll('#tabs button'));const n=parseInt(e.key,10);if(n>=1&&n<=9&&tabs[n-1]){go(tabs[n-1].dataset.p);}});
// subtle 3D: KPI cards tilt toward the pointer (fine pointers only, and never with reduced motion)
(function(){if(window.matchMedia('(prefers-reduced-motion: reduce)').matches||!window.matchMedia('(pointer: fine)').matches)return;
  document.addEventListener('pointermove',e=>{const k=e.target.closest&&e.target.closest('.kpi');if(!k)return;const r=k.getBoundingClientRect();const x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;
    k.style.setProperty('--ry',((x-.5)*9).toFixed(2)+'deg');k.style.setProperty('--rx',((.5-y)*7).toFixed(2)+'deg');k.style.setProperty('--mx',(x*100).toFixed(1)+'%');k.style.setProperty('--my',(y*100).toFixed(1)+'%');});
  document.addEventListener('pointerout',e=>{const k=e.target.closest&&e.target.closest('.kpi');if(!k)return;if(e.relatedTarget&&k.contains(e.relatedTarget))return;k.style.setProperty('--rx','0deg');k.style.setProperty('--ry','0deg');});
})();

const R={messages:rMessages,overview:ovWrap,insights:rInsights,leaders:lvWrap,people:pplWrap,cats:catWrap,travel:rTravel,ta:rTa,controls:rControls,policy:rPolicy};
