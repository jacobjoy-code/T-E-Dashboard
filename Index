  document.getElementById('howTa').innerHTML='Each approval is split into airfare and on-trip costs (hotel, rail and other). Airfare counts in the quarter it is booked, which is assumed to be when the approval is raised. So airfare on approvals raised before Aug 1 sits in last quarter, and airfare on Q3 approvals is already in spend to date. The exception is airfare for future trips where no matching flight booking appears in the expense data, which stays open. On-trip costs count on the travel days and are split by day, so only days after '+dL(LC)+' are still open. '+(M.inrFixes?M.inrFixes+' approvals entered in rupees rather than dollars were converted (they totalled '+$f(M.inrOrig)+' as entered and '+$f(M.inrUsd)+' after conversion).':'');
  const wk=Array.from({length:NW},(_,i)=>i+1),inc=new Float64Array(NW+1),op=new Float64Array(NW+1),ex=new Float64Array(NW+1);
  for(const j of tj){const per=TA.nonair[j]/TA.days[j];for(let d=Math.max(0,TA.sday[j]);d<=Math.min(QD-1,TA.eday[j]);d++){const w=weekOf(d);if(d<=LC)inc[w]+=per;else{op[w]+=per;ex[w]+=per*(1/cov(d-LC)-1);}}
    const bw=weekOf(Math.max(0,Math.min(QD-1,TA.sday[j])));if(TA.q3_air[j]){if(TA.open_air[j])op[bw]+=TA.open_air[j];else inc[Math.max(1,weekOf(Math.max(0,TA.cday[j])))]+=TA.q3_air[j];}}
  chart('cTaWeek',{type:'bar',labels:wk.map(wL),series:[{name:'Already incurred',data:wk.map(w=>inc[w]),color:'#0176D3',stack:'a'},{name:'Approved, still to come',data:wk.map(w=>op[w]),color:'#9050E9',stack:'a'},{name:'Expected, not yet approved',data:wk.map(w=>ex[w]),color:'#D8CBF7',stack:'a'}],fmt:$k,title:i=>wL(i+1)+', '+wR(i+1),vline:{i:weekOf(LC)-1,off:0.5,label:'Today'}});
