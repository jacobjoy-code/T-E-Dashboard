    const t=sv('text',{x:X(i),y:ya-5,'text-anchor':'middle','font-weight':700,fill:'#181818'},g);t.textContent=(b.x.kind==='delta'&&b.x.v>0?'+':'')+fmt(b.x.v);
    const words=b.x.label.split(' ');let line='',lines=[];words.forEach(wd=>{if(textW(line+' '+wd)>bw-4&&line){lines.push(line);line=wd;}else line=line?line+' '+wd:wd;});lines.push(line);
    lines.slice(0,3).forEach((ln,j)=>{const tt=sv('text',{x:X(i),y:H-mb+14+j*12,'text-anchor':'middle'},g);tt.textContent=ln;});
    r.addEventListener('mousemove',ev=>showTip(ev,'<b>'+esc(b.x.label)+'</b><div>'+$f(b.x.v)+'</div>'+(b.x.note?'<div style="opacity:.85;margin-top:4px">'+esc(b.x.note)+'</div>':'')));r.addEventListener('mouseleave',hideTip);});
  (sp.hline||[]).forEach(h=>{sv('line',{x1:ml,x2:W-mr,y1:Y(h.v),y2:Y(h.v),stroke:h.c,'stroke-width':1.5,'stroke-dasharray':'5 4'},g);const t=sv('text',{x:ml+4,y:Y(h.v)-5,fill:h.c,'font-weight':700},g);t.textContent=h.label+' '+fmt(h.v);});
}

// ---------- shared helpers ----------
function $k(n){if(n==null||isNaN(n))return '–';const a=Math.abs(n),s=n<0?'−':'';if(a>=1e6)return s+'$'+(a/1e6).toFixed(2)+'M';if(a>=1e5)return s+'$'+Math.round(a/1e3)+'K';if(a>=1e3)return s+'$'+(a/1e3).toFixed(1)+'K';return s+'$'+Math.round(a);}
function $f(n){if(n==null||isNaN(n))return '–';return (n<0?'−':'')+'$'+Math.round(Math.abs(n)).toLocaleString('en-US');}
function pc(n,dp){if(n==null||!isFinite(n))return '–';return (n*100).toFixed(dp==null?0:dp)+'%';}
function int(n){return Math.round(n).toLocaleString('en-US');}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function signed(n){return (n>0?'+':'')+$k(n);}

function boot(P){
'use strict';
const M=P.meta,DI=P.dict,TX=P.tx,TA=P.ta,N=TX.a.length,NT=TA.e.length;
const Q0=new Date(M.qStart+'T00:00:00'),LC=M.lastComplete,QD=M.qDays,REMAIN=QD-(LC+1),LAST=M.lastDay;
const CATS=M.cats;
const CC={'Airfare':'#0176D3','Lodging':'#06A59A','Ground transport':'#FE9339','Meals':'#9050E9','Entertainment':'#D83A86','Booking & fees':'#8E9CAD'};
const FLBL={air_cap:'Airfare over limit',hotel_cap:'Hotel over nightly limit',premium:'Business or first class',late:'Flight booked 3 days or less ahead',freeze:'Internal travel during freeze',split:'Possible split receipt'};
const EVENTS=new Set(M.events.map(e=>DI.p.indexOf(e)).filter(i=>i>=0));
const NOTAPP=new Set(DI.s.map((s,i)=>s==='Approved'?-1:i).filter(i=>i>=0));
const TRAVX=new Set(DI.x.map((x,i)=>['Airfare','Hotel & Lodging','Room Tax','Hotel Deposit','Subway/Train/Trolley - Cross State/Country'].includes(x)?i:-1).filter(i=>i>=0));
const AIRX=DI.x.indexOf('Airfare'),HOTX=DI.x.indexOf('Hotel & Lodging'),FEEX=DI.x.indexOf('Travel/Booking Fees');
const CI=new Int8Array(N),WK=new Int8Array(N);const xcat=DI.x.map(x=>CATS.indexOf(M.x2cat[x]));
function weekOf(d){return d<=0?1:Math.floor((d-1)/7)+2;}
for(let i=0;i<N;i++){CI[i]=xcat[TX.x[i]];WK[i]=weekOf(TX.d[i]);}
const NW=weekOf(QD-1),LASTW=weekOf(LAST);
function wStart(w){return w===1?0:1+(w-2)*7;}
function dDate(d){const x=new Date(Q0);x.setDate(x.getDate()+d);return x;}
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function dL(d){const x=dDate(d);return MON[x.getMonth()]+' '+x.getDate();}
function wL(w){return 'Wk '+w;}
function wR(w){const s=wStart(w),e=Math.min(QD-1,w===1?0:s+6);return dL(s)+(e>s?' to '+dL(e):'');}
const LCW=dDate(LC).getDay()===6?weekOf(LC):weekOf(LC)-1; // last complete week
const COV=M.cov;function cov(k){return COV[Math.min(COV.length-1,Math.max(0,k))];}

// ---------- filters ----------
const PHS=new Set(['Above your level','Own spend or direct reports','No second level','No budget line']);
const lineOf=(a,b)=>PHS.has(b)?esc(a):esc(a)+' → '+esc(b);
const FK=['ou','ow','ld','l1','l2','e','cat','p','s'],HIER=['ou','ow','ld','l1','l2','e'],TAK=['ou','ow','ld','l1','l2','e'];
const F={ou:-1,ow:-1,ld:-1,l1:-1,l2:-1,e:-1,cat:-1,p:-1,s:-1,q:''};
const FN={ou:'Region',ow:'Budget owner',ld:'Leader',l1:'Leader+1',l2:'Leader+2',e:'Employee',cat:'Category',p:'Purpose',s:'Status'};
const rv=(k,i)=>k==='cat'?CI[i]:TX[k][i];const dictOf=k=>k==='cat'?CATS:DI[k];
let HAY=null;function hay(i){if(!HAY){HAY=new Array(N);for(let j=0;j<N;j++)HAY[j]=(DI.e[TX.e[j]]+'|'+DI.v[TX.v[j]]+'|'+DI.ld[TX.ld[j]]+'|'+DI.l1[TX.l1[j]]+'|'+DI.l2[TX.l2[j]]+'|'+DI.c[TX.c[j]]).toLowerCase();}return HAY[i];}
function pass(i){for(const k of FK){const v=F[k];if(v<0)continue;
  if(k==='ld'){const nm=DI.ld[v],oi=DI.ow.indexOf(nm);if(oi>=0){if(TX.ow[i]!==oi)return false;}else{if(TX.ld[i]!==v)return false;}continue;}
  if(rv(k,i)!==v)return false;}if(F.q&&!hay(i).includes(F.q))return false;return true;}
function passTA(j){for(const k of TAK){const v=F[k];if(v<0)continue;
  if(k==='ld'){const nm=DI.ld[v],oi=DI.ow.indexOf(nm);if(oi>=0){if(TA.ow[j]!==oi)return false;}else{if(TA.ld[j]!==v)return false;}continue;}
  if(TA[k][j]!==v)return false;}if(F.q){const h=(DI.e[TA.e[j]]+'|'+DI.ld[TA.ld[j]]+'|'+DI.l1[TA.l1[j]]+'|'+DI.l2[TA.l2[j]]+'|'+TA.route[j]).toLowerCase();if(!h.includes(F.q))return false;}return true;}
function fillSel(k){const el=document.getElementById('f_'+k),d=dictOf(k),hi=HIER.indexOf(k),cnt=new Map();
  for(let i=0;i<N;i++){let ok=true;for(const kk of FK){if(kk===k)continue;const hj=HIER.indexOf(kk);if(hi>=0&&hj>hi)continue;const v=F[kk];if(v<0)continue;if(kk==='ld'){const nm=DI.ld[v],oi=DI.ow.indexOf(nm);if(oi>=0){if(TX.ow[i]!==oi){ok=false;break;}}else{if(TX.ld[i]!==v){ok=false;break;}}continue;}if(rv(kk,i)!==v){ok=false;break;}}if(!ok)continue;
    if(k==='ld'){cnt.set(rv(k,i),1);const own=DI.ow[TX.ow[i]];if(own&&own!=='No budget line'){const owi=DI.ld.indexOf(own);if(owi>=0)cnt.set(owi,1);}}else cnt.set(rv(k,i),1);}
  const ids=[...cnt.keys()].filter(v=>v>=0&&d[v]!==''&&!PHS.has(d[v])).sort((a,b)=>String(d[a]).localeCompare(String(d[b])));
  const all={ou:'All regions',ow:'All budget owners',ld:'All leaders',l1:'All',l2:'All',e:'All employees',cat:'All categories',p:'All purposes',s:'All statuses'}[k];
  el.innerHTML='<option value="-1">'+all+'</option>'+ids.map(v=>'<option value="'+v+'">'+esc(d[v])+'</option>').join('');
  if(F[k]>=0&&!cnt.has(F[k]))F[k]=-1;el.value=String(F[k]);el.classList.toggle('on',F[k]>=0);}
function fillAll(){FK.forEach(fillSel);document.getElementById('f_q').classList.toggle('on',!!F.q);}
FK.forEach(k=>document.getElementById('f_'+k).addEventListener('change',e=>{F[k]=+e.target.value;fillAll();refresh();}));
let qT;document.getElementById('f_q').addEventListener('input',e=>{clearTimeout(qT);qT=setTimeout(()=>{F.q=e.target.value.trim().toLowerCase();fillAll();refresh();},250);});
document.getElementById('resetBtn').onclick=()=>{FK.forEach(k=>F[k]=-1);F.q='';document.getElementById('f_q').value='';fillAll();refresh();};
document.getElementById('moreBtn').onclick=e=>{const m=document.getElementById('more');const o=m.classList.toggle('open');e.currentTarget.setAttribute('aria-expanded',o);};
function filterTo(k,name){const v=dictOf(k).indexOf(name);if(v<0)return false;F[k]=v;fillAll();refresh();window.scrollTo({top:0,behavior:'smooth'});return true;}
document.addEventListener('click',e=>{const a=e.target.closest('[data-fk]');if(a){e.preventDefault();filterTo(a.dataset.fk,a.dataset.fv);return;}const g=e.target.closest('[data-go]');if(g){e.preventDefault();go(g.dataset.go);}});
function scopeName(){for(const k of ['e','l2','l1','ld','ow','ou'])if(F[k]>=0)return dictOf(k)[F[k]];return M.scopeKind==='all'?'South Asia':M.scope;}
function renderScope(){const el=document.getElementById('scope');const parts=[];
  for(const k of FK)if(F[k]>=0)parts.push('<span class="pillf">'+FN[k]+': '+esc(dictOf(k)[F[k]])+'<button aria-label="Remove '+FN[k]+' filter" data-rm="'+k+'">×</button></span>');
  if(F.q)parts.push('<span class="pillf">Search: '+esc(F.q)+'<button aria-label="Clear search" data-rm="q">×</button></span>');
  el.innerHTML=(parts.length?'Showing ':'Showing everything in this dashboard, ')+parts.join(' ')+' <span>'+int(IDX.length)+' expense lines, '+int(TIX.length)+' travel approvals</span>';
  el.querySelectorAll('[data-rm]').forEach(b=>b.onclick=()=>{const k=b.dataset.rm;if(k==='q'){F.q='';document.getElementById('f_q').value='';}else F[k]=-1;fillAll();refresh();});}

// ---------- whole-population structures ----------
const BUD=P.budget.map(b=>({...b,oui:DI.ou.indexOf(b.ou),owi:DI.ow.indexOf(b.n)}));
const ownFull=new Map();for(let i=0;i<N;i++){const k=TX.ou[i]+'|'+TX.ow[i];ownFull.set(k,(ownFull.get(k)||0)+TX.a[i]);}
const NOBUD=DI.ow.indexOf('No budget line');

// ---------- aggregation ----------
let IDX=[],TIX=[];
function sum(ix){let s=0;for(const i of ix)s+=TX.a[i];return s;}
function grp(ix,kf){const m=new Map();for(const i of ix){const k=kf(i);let o=m.get(k);if(!o){o={k,a:0,n:0,rows:[]};m.set(k,o);}o.a+=TX.a[i];o.n++;o.rows.push(i);}return m;}
function catSums(ix){const c=new Float64Array(6);for(const i of ix)c[CI[i]]+=TX.a[i];return c;}
const orgF=()=>F.ld>=0||F.l1>=0||F.l2>=0||F.e>=0||!!F.q;const sliceF=()=>F.cat>=0||F.p>=0||F.s>=0;
function runRate(ix){let s=0;for(const i of ix)if(TX.d[i]<=LC&&!EVENTS.has(TX.p[i]))s+=TX.a[i];return s/(LC+1);}
/* TA-informed forecast. Remaining quarter = day-to-day spend + approved trip costs still to be incurred + expected trips not yet approved + airfare still to be booked */
function forecast(ix,tix){
  const qtd=sum(ix);const rr=runRate(ix);
  if(sliceF())return {qtd,land:qtd+rr*REMAIN,rr,mode:'runrate',base:rr*REMAIN};
  let base=0,air=0;for(const i of ix){if(TX.d[i]>LC||EVENTS.has(TX.p[i]))continue;if(TX.x[i]===AIRX)air+=TX.a[i];else if(!TX.lk[i])base+=TX.a[i];}
  base=base/(LC+1)*REMAIN;air=air/(LC+1)*REMAIN;
  let openNon=0,unr=0,openAir=0;for(const j of tix){openNon+=TA.open_nonair[j];unr+=TA.exp_unraised[j];openAir+=TA.open_air[j];}
  const airF=Math.max(openAir,air);
  const land=qtd+base+openNon+unr+airF;
  return {qtd,base,openNon,unr,openAir,airF,airRate:air,land,rr,rrLand:qtd+rr*REMAIN,mode:'ta'};
}
function dailyPath(ix,tix,fc){ // projected daily spend after LC for the burn chart
  const out=new Float64Array(QD);if(fc.mode!=='ta'){for(let d=LC+1;d<QD;d++)out[d]=fc.rr;return out;}
  const flat=(fc.base+fc.airF)/REMAIN;for(let d=LC+1;d<QD;d++)out[d]=flat;
  for(const j of tix){const nd=TA.days[j],per=TA.nonair[j]/nd;for(let d=Math.max(TA.sday[j],LC+1);d<=Math.min(TA.eday[j],QD-1);d++)out[d]+=per/cov(d-LC);}
  return out;}
function scopeBudget(ix){
  if(sliceF())return {b:null,mode:'slice',lines:[]};
  const org=orgF();const own=grp(ix,i=>TX.ou[i]+'|'+TX.ow[i]);const lines=[];let tot=0,pr=false;
  for(const b of BUD){if(F.ou>=0&&b.oui!==F.ou)continue;if(F.ow>=0&&b.owi!==F.ow)continue;const k=b.oui+'|'+b.owi,g=own.get(k);if(org&&!g)continue;
    let sh=1;if(org){const full=ownFull.get(k)||0,s=g?g.a:0;sh=full>0?Math.max(0,Math.min(1,s/full)):1;if(sh<0.995)pr=true;}
    const bb=b.b*sh;tot+=bb;lines.push({...b,b:bb,sh,rows:g?g.rows:[]});}
  return {b:tot,mode:org?(pr?'prorated':'full'):(BUD.some(b=>b.share<0.995)?'leaderfile':'full'),lines};}
function taFor(ou,ow){const r=[];for(const j of TIX)if(TA.ou[j]===ou&&TA.ow[j]===ow)r.push(j);return r;}
function status(land,b,q){if(!b)return ['na','No budget'];if(q>b)return ['over','Over budget'];if(land>b)return ['over','Projected over'];if(land>0.92*b)return ['watch','Watch'];return ['ok','On track'];}

// ---------- tables ----------
const TS={};
function table(id,cols,rows,opt){opt=opt||{};const st=TS[id]||(TS[id]={k:opt.sort,dir:-1});const el=document.getElementById(id);if(!el)return;
  if(!rows.length){el.innerHTML='<div class="empty">'+(opt.empty||'Nothing in this view. Remove a filter to see more.')+'</div>';return;}
  const col=cols.find(c=>c.k===st.k);let rs=rows;
  if(col){const g=col.sv||(r=>r[col.k]);rs=[...rows].sort((a,b)=>{const x=g(a),y=g(b);let c;if(typeof x==='string'||typeof y==='string')c=String(x??'').localeCompare(String(y??''));else{const xx=(x==null||isNaN(x))?-Infinity:x,yy=(y==null||isNaN(y))?-Infinity:y;c=xx===yy?0:(xx<yy?-1:1);}return st.dir*c;});}
  const lim=opt.limit?rs.slice(0,opt.limit):rs;
  let h='<table><thead><tr>'+cols.map(c=>'<th class="'+(c.n?'n':'')+'" data-k="'+c.k+'" tabindex="0" '+(st.k===c.k?'aria-sort="'+(st.dir<0?'descending':'ascending')+'"':'')+'>'+c.l+'</th>').join('')+'</tr></thead><tbody>';
  for(const r of lim)h+='<tr>'+cols.map(c=>'<td class="'+(c.n?'n':'')+'">'+(c.f?c.f(r):esc(r[c.k]))+'</td>').join('')+'</tr>';
  el.innerHTML=h+'</tbody></table>'+(opt.limit&&rs.length>opt.limit?'<div class="empty">Showing the top '+opt.limit+' of '+int(rs.length)+'. Use filters or search to narrow.</div>':'');
  el.querySelectorAll('th').forEach(th=>{const go2=()=>{const k=th.dataset.k,c=cols.find(x=>x.k===k);if(st.k===k)st.dir*=-1;else{st.k=k;st.dir=c&&c.n?-1:1;}table(id,cols,rows,opt);};th.onclick=go2;th.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go2();}};});}
const lnk=(k,n)=>'<a href="#" class="flink" data-fk="'+k+'" data-fv="'+esc(n)+'">'+esc(n)+'</a>';
function mix(c,tot){if(tot<=0)return '<div class="mix"></div>';return '<div class="mix" title="'+CATS.map((x,i)=>x+' '+pc(Math.max(0,c[i])/tot)).join(', ')+'">'+CATS.map((x,i)=>c[i]>0?'<i style="width:'+(c[i]/tot*100).toFixed(1)+'%;background:'+CC[x]+'"></i>':'').join('')+'</div>';}
function pace(q,b,land){if(!b)return '';const mx=Math.max(b,land,q)*1.02,col=land>b?'var(--red)':land>0.92*b?'var(--orange)':'var(--green)';return '<div class="bar" title="Spent '+$f(q)+', landing '+$f(land)+', budget '+$f(b)+'"><i style="width:'+(Math.max(0,land)/mx*100).toFixed(1)+'%;background:'+col+';opacity:.25"></i><i style="width:'+(Math.max(0,q)/mx*100).toFixed(1)+'%;background:'+col+'"></i><b style="left:'+(b/mx*100).toFixed(1)+'%"></b></div>';}
function legend(id,names,cols){const el=document.getElementById(id);if(el)el.innerHTML=names.map((n,i)=>'<span><i style="background:'+cols[i]+'"></i>'+esc(n)+'</span>').join('');}
const stat=(k,v,d,c)=>'<div class="kpi" style="--c:'+(c||'var(--brand)')+'"><div class="k">'+k+'</div><div class="v">'+v+'</div><div class="d">'+d+'</div></div>';

// ---------- pages ----------
const PG={messages:['Messages','Send a Slack message to leaders and managers who need attention. Each person receives figures from their own dashboard view.'],overview:['Overview','Budget health, the TA-informed forecast and what needs attention.'],insights:['Insights','Every pattern the rules found in the current view, ranked by impact.'],leaders:['Leaders','Scorecard, reporting lines and category mix for each leader.'],people:['Employees','Who spends, how much and on what.'],cats:['Categories','What the money goes on, month by month and why.'],travel:['Travel','Flights, hotels, routes, booking discipline and vendors.'],ta:['Travel approvals & commit','What approved travel means for the rest of the quarter, without double counting airfare.'],controls:['Policy & controls','Policy exceptions, the approval backlog and data gaps.'],policy:['Policy limits','The travel and expense limits applied in this dashboard.']};
let cur='overview';const dirty=new Set(Object.keys(PG));
document.querySelectorAll('#tabs button').forEach(b=>b.onclick=()=>go(b.dataset.p));
function go(p){cur=p;document.querySelectorAll('#tabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.p===p));document.querySelectorAll('.page').forEach(s=>s.classList.toggle('on',s.id==='p-'+p));
  document.getElementById('title').textContent=PG[p][0];document.getElementById('subtitle').textContent=PG[p][1];document.getElementById('fbar').style.display=(p==='policy'||p==='messages')?'none':'';
  if(dirty.has(p)){R[p]();dirty.delete(p);}else{document.querySelectorAll('#p-'+p+' .chart').forEach(c=>drawChart(c.id));}}
function refresh(){IDX=[];for(let i=0;i<N;i++)if(pass(i))IDX.push(i);TIX=[];for(let j=0;j<NT;j++)if(passTA(j))TIX.push(j);INS=null;renderScope();Object.keys(PG).forEach(p=>dirty.add(p));R[cur]();dirty.delete(cur);
  let s=0;for(const i of IDX)if(TX.f[i]&&TX.a[i]>0)s+=TX.a[i];document.getElementById('flagBadge').textContent=$k(s);}

// ===== OVERVIEW =====
function rOverview(){
  const ix=IDX,fc=forecast(ix,TIX),sb=scopeBudget(ix),el=(LC+1)/QD,b=sb.b,v=b!=null?fc.land-b:null,used=b?fc.qtd/b:null;
  let na=0,ns=0;const NS=DI.s.indexOf('Not Submitted');for(const i of ix){if(NOTAPP.has(TX.s[i]))na+=TX.a[i];if(TX.s[i]===NS)ns+=TX.a[i];}
  const openC=fc.mode==='ta'?fc.openNon+fc.openAir:null;
  const bnote=sb.mode==='slice'?'Hidden for a category, purpose or status slice':sb.mode==='prorated'?'Pro-rated to this part of the org':sb.mode==='leaderfile'?'Your share of each budget line':int(sb.lines.length)+' budget lines';
  document.getElementById('kpis').innerHTML=
    stat('Spend to date',$k(fc.qtd),int(ix.length)+' lines, '+int(new Set(ix.map(i=>TX.e[i])).size)+' people','var(--brand)')+
    stat('Q3 budget',b!=null?$k(b):'–',bnote,'var(--navy)')+
    '<div class="kpi" style="--c:'+(used>el?'var(--red)':'var(--green)')+'"><div class="k">Budget used</div><div class="v '+(used>el+0.05?'red':used>el?'amber':'')+'">'+(used!=null?pc(used):'–')+'</div><div class="meter"><i style="width:'+Math.min(100,(used||0)*100).toFixed(1)+'%;background:'+(used>el?'var(--red)':'var(--green)')+'"></i><b style="left:'+(el*100).toFixed(1)+'%" title="Share of quarter elapsed"></b></div><div class="d">'+pc(el)+' of the quarter gone</div></div>'+
    stat('Open TA commit',openC!=null?$k(openC):'–',openC!=null?'Approved trips not yet in spend':'Not shown for this slice','var(--purple)')+
    stat('Projected landing',$k(fc.land),fc.mode==='ta'?'TA-informed. Run-rate view: '+$k(fc.rrLand):'Run-rate view','var(--purple-2)')+
    '<div class="kpi" style="--c:'+(v>0?'var(--red)':'var(--green)')+'"><div class="k">Projected vs budget</div><div class="v '+(v==null?'':v>0?'red':'green')+'">'+(v==null?'–':signed(v))+'</div><div class="d">'+(v==null?'Needs a whole-spend view':(v>0?'Over by ':'Under by ')+pc(Math.abs(v)/b,1))+'</div></div>'+
    stat('Not yet approved',$k(na),pc(fc.qtd?na/fc.qtd:0)+' of spend, '+$k(ns)+' never submitted','var(--orange)');
  // insights top
  const ins=insights();document.getElementById('insTop').innerHTML=ins.slice(0,6).map(insHTML).join('')||'<div class="empty">No notable patterns in this view.</div>';
  // burn
  const daily=new Float64Array(QD);for(const i of ix)daily[TX.d[i]]+=TX.a[i];const path=dailyPath(ix,TIX,fc);
  const lab=[],act=[],proj=[],paceL=[];let c=0;for(let d=0;d<=LC;d++)c+=daily[d];const tail=fc.qtd-c;let run=0,pr=c;
  for(let d=0;d<QD;d++){lab.push(dL(d));run+=d<=LC?daily[d]:0;act.push(d<=LC?run:null);if(d<LC)proj.push(null);else if(d===LC)proj.push(c);else{pr+=path[d]+(d-LC<=4?tail/4:0);proj.push(pr);}if(b!=null)paceL.push(b*(d+1)/QD);}
  const ser=[{name:'Actual cumulative',data:act,color:'#0176D3',kind:'line',fill:true,width:2.5},{name:'Projected',data:proj,color:'#9050E9',kind:'line',dash:'6 5',width:2.5}];
  if(b!=null)ser.push({name:'Even budget pace',data:paceL,color:'#9A9A9A',kind:'line',dash:'2 3',width:1.3});
  chart('cBurn',{type:'line',labels:lab,series:ser,fmt:$k,hline:b!=null?[{v:b,c:'#BA0517',label:'Budget '+$k(b)}]:[],vline:{i:LC,label:'Data to '+dL(LC)},title:i=>dL(i)+', 2026',xEvery:14});
  document.getElementById('burnSub').textContent='Actual to '+dL(LC)+', then '+(fc.mode==='ta'?'the TA-informed projection':'the run-rate')+' to '+dL(QD-1)+'. Lands at '+$k(fc.land)+(v!=null?', '+(v>0?$k(v)+' over':$k(-v)+' under')+' budget.':'.');
  // waterfall
  const items=[{label:'Spend to date',v:fc.qtd,kind:'total',color:'#0176D3'}];
  if(fc.mode==='ta'){items.push({label:'Day-to-day spend',v:fc.base,kind:'delta',color:'#8E9CAD',note:'Spend not tied to an approved trip, at its current daily rate'},{label:'Approved trips still to come',v:fc.openNon,kind:'delta',color:'#7526E3',note:'Hotel, rail and other costs for approved trip days after '+dL(LC)},{label:'Trips not yet approved',v:fc.unr,kind:'delta',color:'#B490F0',note:'Expected from how far ahead approvals are usually raised'},{label:'Airfare still to book',v:fc.airF,kind:'delta',color:'#1B96FF',note:'Bookings at the current airfare rate, including '+$k(fc.openAir)+' approved but not yet booked'});}
  else items.push({label:'Run-rate to '+dL(QD-1),v:fc.land-fc.qtd,kind:'delta',color:'#9050E9'});
  items.push({label:'Projected landing',v:fc.land,kind:'total',color:v>0?'#BA0517':'#2E844A'});
  chart('cWater',{type:'waterfall',labels:items.map(x=>x.label),items,fmt:$k,hline:b!=null?[{v:b,c:'#032D60',label:'Budget'}]:[]});
