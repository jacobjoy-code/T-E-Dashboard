  for(const i of IDX){const d=dDate(TX.d[i]);out.push([d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'),WK[i],DI.ou[TX.ou[i]],DI.ld[TX.ld[i]],DI.l1[TX.l1[i]],DI.l2[TX.l2[i]],DI.ow[TX.ow[i]],DI.e[TX.e[i]],DI.x[TX.x[i]],CATS[CI[i]],DI.p[TX.p[i]],DI.s[TX.s[i]],DI.v[TX.v[i]],DI.c[TX.c[i]],TX.a[i],TX.cu[i]?'Yes':'No',TX.lk[i]?'Yes':'No',M.flags.filter((f,b)=>TX.f[i]&(1<<b)).map(f=>FLBL[f]).join('; ')].map(q).join(','));}
  const blob=new Blob(['\ufeff'+out.join('\n')],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='te_q3_lines.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);};
document.getElementById('freshness').innerHTML='Data through <b>'+dL(LAST)+', '+dDate(LAST).getFullYear()+'</b> · rebuilt '+(M.generated?new Date(M.generated).toLocaleString([],{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}):'')+(M.refreshError?' · <span style="color:#BA0517;font-weight:700" title="'+esc(M.refreshError)+'">auto-refresh failed, showing last good data</span>':'')+'<br>'+(M.user?esc(M.user)+' · ':'')+(M.scopeKind==='all'?'All leaders':'Showing <b>'+esc(M.scope)+'</b>')+' · build '+esc(M.codeVersion||'?');
  {const e2=dDate(QD-1);document.getElementById('crumb').textContent=(M.quarterLabel||'')+' · '+dL(0)+' to '+dL(QD-1)+', '+e2.getFullYear()+(M.scopeKind==='all'?'':' · '+M.scope);}

