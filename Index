(function(){
  const PAGE_VERSION='2026.10.27-f';
  const lock=document.getElementById('lock'),form=document.getElementById('lockForm');
  const show=(title,msg)=>{lock.hidden=false;form.innerHTML='<div class="logo" style="width:42px;height:42px">T&amp;E</div><h1>'+title+'</h1><p>'+msg+'</p>';};
  const b64=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
  async function gunzip(bytes){if(!('DecompressionStream' in window))throw new Error('Please open this in a current version of Chrome, Edge, Safari or Firefox.');const s=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));return await new Response(s).text();}
  show('Loading your dashboard','Checking your access and preparing your team\'s numbers. This takes a few seconds.');
  document.getElementById('main').style.visibility='hidden';
  google.script.run.withSuccessHandler(async s=>{
    try{const r=JSON.parse(s);if(r.error){show('You do not have access',esc(r.error));return;}
      const P=JSON.parse(await gunzip(b64(r.gz)));boot(P);lock.hidden=true;document.getElementById('main').style.visibility='';
      if(P.meta.codeVersion!==PAGE_VERSION){const d=document.createElement('div');d.setAttribute('role','alert');d.style.cssText='background:#FEF1E1;border:1px solid #DD7A01;color:#5C3300;padding:10px 14px;border-radius:4px;margin-bottom:14px;font-size:13px';
        d.innerHTML='<b>Page and script are different versions.</b> This page is build '+PAGE_VERSION+' but the script is build '+esc(P.meta.codeVersion||'older')+'. In Apps Script make sure both Code.gs and Index.html are the latest files, then Deploy &gt; Manage deployments &gt; Edit &gt; New version.';document.getElementById('main').prepend(d);}
      if(P.meta.syncWarning){const w=document.createElement('div');w.setAttribute('role','alert');w.style.cssText='background:#FEF1E1;border:1px solid #DD7A01;color:#5C3300;padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13px';w.innerHTML='<b>Leader columns are not synced from Workday.</b> '+esc(P.meta.syncWarning)+' Budget figures may be charged to the wrong leader until this is fixed. Only admins see this message.';document.getElementById('main').prepend(w);}
    }catch(e){console.error(e);show('The dashboard could not open',esc(e.message));}
  }).withFailureHandler(e=>show('The dashboard could not open',esc(e&&e.message?e.message:String(e)))).getPayload();
})();
