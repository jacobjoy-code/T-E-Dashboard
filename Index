  table('tTaLeader',[{k:'n2',l:'Leader',f:r=>lnk('ld',r.n2)},{k:'n',l:'Approvals',n:1},{k:'trv',l:'Travellers',n:1},{k:'tot',l:'Approved',n:1,f:r=>$f(r.tot)},{k:'q3',l:'Lands in Q3',n:1,f:r=>$f(r.q3)},{k:'inc',l:'Incurred (estimate)',n:1,f:r=>$f(r.inc)},{k:'act',l:'Actual trip spend',n:1,f:r=>$f(r.act)},{k:'acc',l:'Accuracy',n:1,f:r=>r.acc==null?'–':'<span class="bdg '+(r.acc>1.15?'over':r.acc<0.85?'watch':'ok')+'">'+pc(r.acc)+'</span>'},{k:'open',l:'Open commit',n:1,f:r=>'<b>'+$f(r.open)+'</b>'},{k:'noTa',l:'Travel without TA',n:1,f:r=>r.noTa?'<span style="color:var(--red)">'+$f(r.noTa)+'</span>':'–'}],LR,{sort:'open'});
  const NR=[...noTaE.entries()].map(([e,rs])=>{let a=0,ai=0;for(const i of rs){a+=TX.a[i];if(TX.x[i]===AIRX)ai+=TX.a[i];}return {name:DI.e[e],ld:DI.ld[TX.ld[rs[0]]],a,ai,n:rs.length};});
  table('tNoTa',[{k:'name',l:'Employee',f:r=>lnk('e',r.name)+'<span class="mt">'+esc(r.ld)+'</span>'},{k:'a',l:'Travel spend',n:1,f:r=>$f(r.a)},{k:'ai',l:'Of which airfare',n:1,f:r=>$f(r.ai)},{k:'n',l:'Lines',n:1}],NR,{sort:'a',limit:100,empty:'Every traveller in view has an approval on file.'});
