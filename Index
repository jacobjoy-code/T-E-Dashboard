<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>T&amp;E Command Center</title>
<style>
:root{
  --brand:#0176D3;--brand-dk:#014486;--navy:#032D60;--sky:#1B96FF;--sky-lt:#EEF4FF;--sky-xl:#F7FAFF;
  --bg:#F3F3F3;--card:#FFFFFF;--line:#E5E5E5;--line-2:#F3F3F3;--input:#C9C9C9;
  --text:#181818;--text-2:#444444;--text-3:#747474;
  --green:#2E844A;--green-lt:#EBF7E6;--amber:#A96404;--amber-bg:#FEF1E1;--orange:#DD7A01;--red:#BA0517;--red-lt:#FEDED8;
  --purple:#7526E3;--purple-2:#9050E9;--purple-lt:#F2ECFD;--teal:#06A59A;
  --ai:linear-gradient(135deg,#0176D3 0%,#7526E3 100%);
  --font:'Salesforce Sans',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  --shadow:0 2px 2px 0 rgba(0,0,0,.10);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);font-size:13px;line-height:1.5;-webkit-font-smoothing:antialiased}
button,select,input,textarea{font-family:inherit;font-size:13px;color:var(--text)}
:focus-visible{outline:2px solid var(--brand);outline-offset:2px}
.num,td.n{font-variant-numeric:tabular-nums}
a{color:var(--brand)}

/* global header */
.gh{background:#fff;height:52px;display:flex;align-items:center;gap:14px;padding:0 20px;border-bottom:1px solid var(--line);position:relative;z-index:30}
.logo{width:34px;height:34px;border-radius:8px;background:linear-gradient(140deg,#1B96FF,#0176D3 55%,#014486);display:grid;place-items:center;color:#fff;font-weight:800;font-size:12px;letter-spacing:-.02em;box-shadow:inset 0 -2px 0 rgba(0,0,0,.12)}
.gh .app{font-weight:700;font-size:15px}
.gh .app span{display:block;font-weight:400;font-size:11.5px;color:var(--text-3);line-height:1.1}
.gh .sp{flex:1}
.gh .who{font-size:12px;color:var(--text-2);text-align:right;line-height:1.35}
.gh .who b{color:var(--text)}
.ghbtn{height:32px;border:1px solid var(--input);background:#fff;border-radius:4px;padding:0 12px;cursor:pointer;font-weight:600;color:var(--brand)}
.ghbtn:hover{background:var(--sky-xl)}
.ghbtn.ai{border:0;color:#fff;background:var(--ai);display:inline-flex;align-items:center;gap:6px}
.ghbtn.ai:hover{filter:brightness(1.08)}

/* context band */
.band{background:linear-gradient(100deg,#032D60 0%,#014486 45%,#0176D3 100%);color:#fff;padding:22px 24px 0;position:relative;overflow:hidden}
.band::after{content:"";position:absolute;right:-80px;top:-120px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(27,150,255,.35),rgba(27,150,255,0) 70%);pointer-events:none}
.band .crumb{font-size:12px;color:#B8D7F5}
.band h1{margin:2px 0 4px;font-size:24px;font-weight:700;letter-spacing:-.01em}
.band .sub{font-size:13px;color:#D8E9FA;max-width:80ch}
.tabs{display:flex;gap:2px;margin-top:18px;overflow-x:auto;position:relative;z-index:1}
.tabs button{all:unset;cursor:pointer;padding:10px 14px 11px;color:#D8E9FA;font-weight:600;font-size:13px;border-radius:6px 6px 0 0;white-space:nowrap;display:flex;gap:6px;align-items:center}
.tabs button:hover{color:#fff;background:rgba(255,255,255,.08)}
.tabs button[aria-selected="true"]{background:var(--bg);color:var(--brand-dk)}
.tabs button:focus-visible{outline:2px solid #fff;outline-offset:-2px}
.tabs .badge{font-size:10.5px;padding:0 6px;border-radius:9px;background:rgba(255,255,255,.18);font-weight:700}
.tabs button[aria-selected="true"] .badge{background:var(--red-lt);color:var(--red)}

/* filters */
.fbar{position:sticky;top:0;z-index:25;background:rgba(243,243,243,.97);backdrop-filter:blur(6px);padding:12px 24px;border-bottom:1px solid var(--line)}
.frow{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
.fld{display:flex;flex-direction:column;gap:2px;flex:1 1 150px;min-width:130px;max-width:230px}
.fld label{font-size:12px;color:var(--text-2)}
.fld select,.fld input{height:32px;border:1px solid var(--input);border-radius:4px;background:#fff;padding:0 8px;width:100%}
.fld select.on,.fld input.on{border-color:var(--brand);box-shadow:inset 0 0 0 1px var(--brand);background:var(--sky-xl)}
.fact{display:flex;gap:8px;margin-left:auto;flex-wrap:wrap}
.btn{height:32px;padding:0 14px;border-radius:4px;border:1px solid var(--input);background:#fff;color:var(--brand);font-weight:600;cursor:pointer}
.btn:hover{background:var(--sky-xl)}
.btn.brand{background:var(--brand);border-color:var(--brand);color:#fff}
.btn.brand:hover{background:var(--brand-dk)}
.more{display:none;margin-top:10px}.more.open{display:flex}
.scope{margin-top:8px;font-size:12px;color:var(--text-2);display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.pillf{display:inline-flex;align-items:center;gap:2px;background:#fff;border:1px solid var(--input);border-radius:15px;padding:1px 3px 1px 10px;color:var(--text);font-weight:600}
.pillf button{all:unset;cursor:pointer;width:18px;height:18px;border-radius:9px;display:grid;place-items:center;color:var(--text-3)}
.pillf button:hover{background:var(--line);color:var(--text)}

main{padding:16px 24px 64px}
.page{display:none}.page.on{display:block}
.grid{display:grid;gap:16px;margin-bottom:16px;grid-template-columns:minmax(0,1fr)}
.g2{grid-template-columns:repeat(2,minmax(0,1fr))}.g3{grid-template-columns:repeat(3,minmax(0,1fr))}
.g32{grid-template-columns:minmax(0,3fr) minmax(0,2fr)}.g23{grid-template-columns:minmax(0,2fr) minmax(0,3fr)}
.card{background:var(--card);border:1px solid var(--line);border-radius:4px;box-shadow:var(--shadow);min-width:0}
.ch{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:12px 16px 0}
.ch h2{margin:0;font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px}
.ch p{margin:2px 0 0;color:var(--text-3);font-size:12px}
.cb{padding:12px 16px 16px}
.cb.flush{padding:8px 0 0}
.ico{width:24px;height:24px;border-radius:4px;display:inline-grid;place-items:center;color:#fff;flex:none}
.ico svg{width:14px;height:14px;fill:#fff}
.foot{color:var(--text-3);font-size:11.5px;padding:0 16px 12px}
details.how{padding:0 16px 12px;color:var(--text-2);font-size:12px}
details.how summary{cursor:pointer;color:var(--brand);font-weight:600;list-style:none}
details.how summary::-webkit-details-marker{display:none}
details.how summary::before{content:"ⓘ ";}
details.how p{margin:6px 0 0;max-width:90ch}

/* KPI highlights */
.kpis{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:12px;margin-bottom:16px}
.kpi{background:#fff;border:1px solid var(--line);border-radius:4px;box-shadow:var(--shadow);padding:12px 14px;position:relative;overflow:hidden;min-width:0}
.kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--brand))}
.kpi .k{font-size:12px;color:var(--text-2);display:flex;justify-content:space-between;gap:6px}
.kpi .v{font-size:22px;font-weight:700;letter-spacing:-.01em;margin-top:2px;white-space:nowrap}
.kpi .d{font-size:11.5px;color:var(--text-3);margin-top:1px}
.kpi .v.red{color:var(--red)}.kpi .v.green{color:var(--green)}.kpi .v.amber{color:var(--amber)}
.meter{height:6px;background:var(--line-2);border-radius:3px;margin-top:8px;position:relative}
.meter i{position:absolute;left:0;top:0;bottom:0;border-radius:3px}
.meter b{position:absolute;top:-3px;width:2px;height:12px;background:var(--text)}

/* insights */
.ai-card{position:relative;border:0;background:#fff;border-radius:6px;box-shadow:var(--shadow);padding:1px}
.ai-card::before{content:"";position:absolute;inset:0;border-radius:6px;padding:1.5px;background:var(--ai);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.ai-head{display:flex;align-items:center;gap:10px;padding:12px 16px 4px}
.ai-head h2{margin:0;font-size:14px;font-weight:700;background:var(--ai);-webkit-background-clip:text;background-clip:text;color:transparent}
.ai-head .chip{font-size:11px;color:var(--purple);background:var(--purple-lt);border-radius:10px;padding:1px 8px;font-weight:600}
.ins{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;padding:4px 8px 10px}
.ins.full{grid-template-columns:repeat(2,minmax(0,1fr))}
.in{display:flex;gap:10px;padding:10px 8px;border-bottom:1px solid var(--line-2)}
.in .dot{width:8px;flex:none;border-radius:4px;margin-top:4px;height:30px}
.in h3{margin:0;font-size:13px;font-weight:700}
.in p{margin:2px 0 0;color:var(--text-2);font-size:12.5px}
.in .act{margin-top:4px;font-size:12px;color:var(--brand);cursor:pointer;background:none;border:0;padding:0;font-weight:600}
.sev-risk .dot{background:var(--red)}.sev-watch .dot{background:var(--orange)}.sev-good .dot{background:var(--green)}.sev-info .dot{background:var(--brand)}

/* tables */
.tw{overflow:auto;max-height:520px}
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{position:sticky;top:0;background:#FAFAF9;text-align:left;font-weight:700;color:var(--text-2);font-size:12px;padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;cursor:pointer;user-select:none;z-index:1}
th.n,td.n{text-align:right;white-space:nowrap}
th[aria-sort="descending"]::after{content:" ▾";color:var(--brand)}
th[aria-sort="ascending"]::after{content:" ▴";color:var(--brand)}
td{padding:7px 10px;border-bottom:1px solid var(--line-2);vertical-align:middle}
tbody tr:hover td{background:var(--sky-xl)}
.nm{font-weight:600}
.mt{display:block;color:var(--text-3);font-size:11.5px}
.flink{color:var(--brand);text-decoration:none;font-weight:600}
.flink:hover{text-decoration:underline}
.bdg{display:inline-block;padding:1px 8px;border-radius:12px;font-size:11.5px;font-weight:600;white-space:nowrap}
.bdg.ok{background:var(--green-lt);color:var(--green)}.bdg.watch{background:var(--amber-bg);color:var(--amber)}.bdg.over{background:var(--red-lt);color:var(--red)}.bdg.na{background:var(--line-2);color:var(--text-3)}.bdg.info{background:var(--sky-lt);color:var(--brand-dk)}
.bar{height:8px;background:var(--line-2);border-radius:4px;position:relative;min-width:90px}
.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:4px}
.bar b{position:absolute;top:-3px;width:2px;height:14px;background:var(--text)}
.mix{display:flex;height:8px;border-radius:4px;overflow:hidden;min-width:110px;background:var(--line-2)}
.mix i{display:block;height:100%}
.empty{padding:26px;text-align:center;color:var(--text-3)}
.tog{all:unset;cursor:pointer;width:18px;display:inline-block;color:var(--brand);font-weight:700}
.l1 td:first-child{padding-left:30px}.l2 td:first-child{padding-left:54px}
.l0 td{font-weight:600}
.heat td.h{text-align:right;font-variant-numeric:tabular-nums}
.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;color:var(--text-2);padding:0 16px}
.legend span{display:inline-flex;align-items:center;gap:5px}
.legend i{width:10px;height:10px;border-radius:2px;display:inline-block}
.tsearch{height:30px;border:1px solid var(--input);border-radius:4px;padding:0 8px;width:220px}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
.score{display:inline-grid;place-items:center;width:26px;height:22px;border-radius:4px;font-weight:700;font-size:11.5px}

/* charts */
.chart{position:relative;height:260px}
.chart.tall{height:330px}.chart.short{height:200px}
.chart svg{display:block;width:100%;height:100%;overflow:visible}
.chart text{font-family:var(--font);fill:#5C5C5C;font-size:11px}
.tip{position:fixed;pointer-events:none;background:#032D60;color:#fff;border-radius:6px;padding:8px 10px;font-size:12px;line-height:1.45;box-shadow:0 4px 14px rgba(0,0,0,.18);z-index:90;max-width:300px;display:none}
.tip b{font-weight:700}.tip .r{display:flex;gap:8px;justify-content:space-between}.tip i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px}

/* policy page */
.pol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;max-width:1100px}
.pol .card{padding:18px 20px}
.pol h3{margin:0 0 10px;font-size:15px;display:flex;gap:10px;align-items:center}
.lim{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0;border-top:1px solid var(--line-2)}
.lim span{color:var(--text-2)}.lim b{font-size:18px}
.pol .note{color:var(--text-2);font-size:13px;margin:8px 0 0}

/* assistant */
.asst{position:fixed;right:20px;bottom:20px;z-index:60}
.fab{width:56px;height:56px;border-radius:50%;border:0;background:var(--ai);color:#fff;cursor:pointer;box-shadow:0 6px 18px rgba(1,68,134,.35);display:grid;place-items:center}
.fab svg{width:26px;height:26px;fill:#fff}
.drawer{position:fixed;right:20px;bottom:88px;width:400px;max-width:calc(100vw - 24px);height:min(620px,calc(100vh - 120px));background:#fff;border-radius:10px;box-shadow:0 12px 40px rgba(3,45,96,.28);display:none;flex-direction:column;overflow:hidden;z-index:61}
.drawer.open{display:flex}
.dh{background:var(--ai);color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px}
.dh b{font-size:14px}.dh span{font-size:11.5px;opacity:.85;display:block}
.dh button{margin-left:auto;all:unset;cursor:pointer;width:28px;height:28px;border-radius:14px;display:grid;place-items:center;font-size:18px}
.dh button:hover{background:rgba(255,255,255,.15)}
.msgs{flex:1;overflow:auto;padding:12px;background:#FAFAF9;display:flex;flex-direction:column;gap:10px}
.m{max-width:92%;padding:9px 11px;border-radius:10px;font-size:12.5px;line-height:1.5}
.m.u{align-self:flex-end;background:var(--brand);color:#fff;border-bottom-right-radius:3px}
.m.b{align-self:flex-start;background:#fff;border:1px solid var(--line);border-bottom-left-radius:3px}
.m.b table{font-size:12px;margin-top:6px}
.m.b td,.m.b th{padding:4px 6px}
.m.b .acts{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.m.b .acts button{border:1px solid var(--input);background:#fff;border-radius:14px;padding:2px 10px;cursor:pointer;color:var(--brand);font-weight:600;font-size:12px}
.sugg{display:flex;gap:6px;flex-wrap:wrap;padding:8px 12px;border-top:1px solid var(--line);background:#fff}
.sugg button{border:1px solid #D8CBF7;background:var(--purple-lt);color:var(--purple);border-radius:14px;padding:3px 10px;cursor:pointer;font-size:12px;font-weight:600}
.din{display:flex;gap:8px;padding:10px 12px;border-top:1px solid var(--line);background:#fff}
.din input{flex:1;height:36px;border:1px solid var(--input);border-radius:18px;padding:0 14px}
.din button{height:36px;border-radius:18px;border:0;background:var(--brand);color:#fff;padding:0 16px;font-weight:700;cursor:pointer}

/* lock */
.lock[hidden]{display:none!important}
.lock{position:fixed;inset:0;background:linear-gradient(120deg,#032D60,#014486 50%,#0176D3);display:grid;place-items:center;z-index:200;padding:20px}
.lock .box{background:#fff;border-radius:8px;box-shadow:0 20px 60px rgba(0,0,0,.3);width:400px;max-width:100%;padding:28px}
.lock h1{font-size:18px;margin:14px 0 4px}.lock p{color:var(--text-2);margin:0 0 16px}
.lock input{width:100%;height:38px;border:1px solid var(--input);border-radius:4px;padding:0 10px;font-size:14px}
.lock button{margin-top:12px;width:100%;height:38px;border:0;border-radius:4px;background:var(--brand);color:#fff;font-weight:700;cursor:pointer;font-size:14px}
.lock .err{color:var(--red);font-size:12.5px;min-height:18px;margin-top:8px}

@media (max-width:1280px){.kpis{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media (max-width:980px){.g2,.g3,.g32,.g23,.ins,.ins.full,.pol{grid-template-columns:minmax(0,1fr)}.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.fbar{position:static}.gh .who{display:none}}
@media (max-width:560px){main,.fbar,.band{padding-left:12px;padding-right:12px}.fld{max-width:none}.band h1{font-size:20px}.gh .app span{display:none}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
@media print{.fbar,.asst,.tabs,.gh .ghbtn{display:none!important}.page{display:block!important;break-after:page}}

/* ===== premium layer (v3) ===== */
html,body{background:radial-gradient(1100px 520px at 8% -8%,#E6F0FF 0%,rgba(230,240,255,0) 60%),radial-gradient(900px 480px at 108% -4%,#F1EAFE 0%,rgba(241,234,254,0) 55%),#F3F5F9;}
.gh{background:rgba(255,255,255,.86);-webkit-backdrop-filter:saturate(160%) blur(10px);backdrop-filter:saturate(160%) blur(10px);box-shadow:0 1px 0 rgba(3,45,96,.06),0 8px 24px -18px rgba(3,45,96,.35);}
.logo{box-shadow:0 6px 14px -6px rgba(1,68,134,.7),inset 0 1px 0 rgba(255,255,255,.35);}
.band{box-shadow:0 18px 40px -26px rgba(3,45,96,.7);}
.tabs button[aria-selected="true"]{box-shadow:0 -3px 0 #0176D3 inset,0 10px 18px -14px rgba(3,45,96,.6);}
.card{border-radius:10px;box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 1px 2px rgba(3,45,96,.05),0 14px 30px -22px rgba(3,45,96,.32);transition:box-shadow .3s ease;}
.card:hover{box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 2px 4px rgba(3,45,96,.06),0 20px 36px -22px rgba(3,45,96,.40);}
.ch h2{letter-spacing:-.01em;}
.kpi{border-radius:10px;transform-style:preserve-3d;transform:perspective(900px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .35s cubic-bezier(.2,.7,.2,1),box-shadow .35s ease;background:linear-gradient(180deg,#FFFFFF 0%,#FAFBFD 100%);box-shadow:0 1px 0 rgba(255,255,255,.95) inset,0 2px 4px rgba(3,45,96,.06),0 20px 34px -22px rgba(3,45,96,.5);will-change:transform;}
.kpi::before{width:5px;border-radius:10px 0 0 10px;box-shadow:2px 0 10px -2px var(--c,#0176D3);}
.kpi::after{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(240px circle at var(--mx,50%) var(--my,25%),rgba(255,255,255,.7),rgba(255,255,255,0) 62%);pointer-events:none;opacity:var(--gl,0);transition:opacity .3s ease;}
.kpi:hover{--gl:1;box-shadow:0 1px 0 rgba(255,255,255,.95) inset,0 4px 8px rgba(3,45,96,.08),0 30px 44px -24px rgba(3,45,96,.55);}
.kpi .v{text-shadow:0 1px 0 rgba(255,255,255,.7);}
.chart svg{filter:drop-shadow(0 6px 8px rgba(3,45,96,.12));overflow:visible;}
.bar,.mix,.meter{box-shadow:inset 0 1px 2px rgba(3,45,96,.12);}
.bdg{box-shadow:0 1px 0 rgba(255,255,255,.6) inset,0 1px 2px rgba(3,45,96,.10);}
.ai-card{box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 22px 40px -28px rgba(88,38,227,.45);}
.btn{box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 1px 2px rgba(3,45,96,.08);transition:transform .15s ease,box-shadow .15s ease;}
.btn:hover{transform:translateY(-1px);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 6px 14px -8px rgba(3,45,96,.5);}
.btn.brand{background:linear-gradient(180deg,#1A86E8 0%,#0170C4 100%);box-shadow:0 1px 0 rgba(255,255,255,.25) inset,0 8px 16px -10px rgba(1,112,196,.9);}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none;}
.kbdhint{font-size:11.5px;color:var(--text-3);padding:4px 0 0;}
.tie{display:flex;gap:8px;align-items:center;margin:0 16px 14px;padding:8px 12px;border-radius:8px;background:linear-gradient(90deg,#EBF7E6,#F5FBF2);color:#2E844A;font-size:12px;box-shadow:0 1px 0 rgba(255,255,255,.8) inset;}
.tie b{font-weight:800;}
.tie.warn{background:linear-gradient(90deg,#FEF1E1,#FFF8EE);color:#A96404;}
.banner{padding:10px 14px;border-radius:8px;background:#FEF1E1;color:#5C3300;border:1px solid #F2C27E;margin:0 0 12px;font-size:13px;}
.banner.ok{background:#EBF7E6;color:#1F5C33;border-color:#BFE3B0;}
.banner.warn{background:#FEF1E1;color:#5C3300;border-color:#F2C27E;}
/* messages */
.msgwrap{display:grid;grid-template-columns:minmax(300px,380px) minmax(0,1fr);gap:16px;align-items:start;}
@media (max-width:1000px){.msgwrap{grid-template-columns:minmax(0,1fr);}}
.msgcol{position:sticky;top:132px;}
.msgtools{padding:12px 16px 4px;display:grid;gap:8px;}
.msgtools input[type=search]{height:34px;border:1px solid #C9C9C9;border-radius:6px;padding:0 10px;width:100%;}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:#EEF1F5;border-radius:8px;padding:3px;}
.seg button{all:unset;cursor:pointer;text-align:center;padding:6px 8px;border-radius:6px;font-size:12px;font-weight:600;color:#44546B;}
.seg button[aria-pressed="true"]{background:#fff;color:#032D60;box-shadow:0 1px 2px rgba(3,45,96,.15);}
.msgbtns{display:flex;gap:8px;flex-wrap:wrap;}
.msgbtns .btn{height:30px;font-size:12px;padding:0 10px;}
.rlist{max-height:520px;overflow:auto;padding:6px 8px 10px;}
.rcp{display:grid;grid-template-columns:18px 1fr auto;grid-template-areas:"cb nm st" "cb kd mail";gap:2px 8px;align-items:center;padding:8px 8px;border-radius:8px;cursor:pointer;border-bottom:1px solid #F0F2F5;}
.rcp:hover{background:#F6F9FD;}
.rcp.on{background:#EEF4FF;}
.rcp input{grid-area:cb;margin:0;}
.rcp .nm{grid-area:nm;font-weight:600;font-size:13px;}
.rcp .st{grid-area:st;}
.rcp .kind{grid-area:kd;font-size:11.5px;color:#747474;}
.rcp .mail{grid-area:mail;font-size:11px;}
.mail.ok{color:#2E844A;}.mail.no{color:#A96404;}
.tplgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:8px 0 14px;}
@media (max-width:1200px){.tplgrid{grid-template-columns:repeat(2,minmax(0,1fr));}}
.tpl{position:relative;display:grid;gap:4px;padding:12px 12px 12px 14px;border:1px solid #DCE3EC;border-radius:10px;cursor:pointer;background:linear-gradient(180deg,#fff,#FAFBFD);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 6px 14px -12px rgba(3,45,96,.4);transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease;}
.tpl:hover{transform:translateY(-2px);box-shadow:0 1px 0 rgba(255,255,255,.9) inset,0 14px 22px -16px rgba(3,45,96,.5);}
.tpl.on{border-color:#0176D3;box-shadow:0 0 0 2px rgba(1,118,211,.18),0 14px 24px -16px rgba(1,118,211,.7);}
.tpl input{position:absolute;opacity:0;pointer-events:none;}
.tpl b{font-size:13px;}
.tpl span{font-size:12px;color:#5C6B7E;line-height:1.4;}
.sect{margin:0 0 6px;font-size:12.5px;font-weight:800;letter-spacing:.02em;color:#44546B;text-transform:uppercase;}
.msgmain textarea{width:100%;border:1px solid #C9C9C9;border-radius:8px;padding:10px 12px;font:inherit;font-size:13px;resize:vertical;}
.count{font-size:11.5px;color:#747474;text-align:right;margin-top:4px;}
.prevhead{display:flex;justify-content:space-between;align-items:center;}
.pnav{display:flex;gap:6px;align-items:center;font-size:12px;color:#747474;}
.pnav button{all:unset;cursor:pointer;width:26px;height:26px;border-radius:13px;text-align:center;line-height:26px;border:1px solid #DCE3EC;background:#fff;}
.pnav button:hover{background:#F6F9FD;}
.slack{background:#fff;border:1px solid #E3E6EA;border-left:4px solid #0176D3;border-radius:8px;padding:14px 16px;box-shadow:0 12px 24px -18px rgba(3,45,96,.45);font-size:13px;color:#1D1C1D;}
.slack .ttl{font-weight:800;font-size:15px;margin-bottom:8px;}
.slack .body{line-height:1.55;}
.slack .body .q{border-left:3px solid #D0D5DD;padding-left:10px;color:#616061;margin:6px 0;}
.slack .body .gap{height:8px;}
.slack .foot{font-size:11.5px;color:#616061;margin-top:10px;}
.slack .open{display:inline-block;margin-top:10px;border:1px solid #DDD;border-radius:6px;padding:6px 12px;font-weight:700;color:#1264A3;background:#fff;}
.pfor{font-size:11.5px;color:#747474;margin-top:8px;}
.sendbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:14px 0;padding:12px 14px;border-radius:10px;background:#fff;border:1px solid #DCE3EC;box-shadow:0 10px 20px -16px rgba(3,45,96,.45);}
.sendbar .hint{font-size:12.5px;color:#44546B;}
.scrim{position:fixed;inset:0;background:rgba(3,45,96,.38);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);display:grid;place-items:center;z-index:120;padding:16px;}
.scrim[hidden]{display:none;}
.modal{background:#fff;border-radius:12px;box-shadow:0 30px 60px -20px rgba(3,45,96,.6);width:min(520px,100%);padding:20px 22px;max-height:86vh;overflow:auto;}
.modal h3{margin:0 0 8px;font-size:17px;}
.mnote{font-size:13px;color:#44546B;line-height:1.5;}
.mlist{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0;max-height:180px;overflow:auto;}
.chip2{background:#EEF4FF;color:#032D60;border-radius:14px;padding:3px 10px;font-size:12px;font-weight:600;}
.confirm{display:flex;gap:8px;align-items:flex-start;font-size:13px;margin:10px 0;}
.mbtns{display:flex;justify-content:flex-end;gap:8px;margin-top:12px;}
.fail{font-size:13px;padding:6px 0;border-bottom:1px solid #F0F2F5;}
.msgtable td{font-size:12px;}
</style>
</head>
<body>
<div class="lock" id="lock">
  <div class="box" id="lockForm"></div>
</div>

<header class="gh">
  <div class="logo" aria-hidden="true">T&amp;E</div>
  <div class="app">T&amp;E Command Center<span>South Asia · Finance</span></div>
  <div class="sp"></div>
  <div class="who" id="freshness"></div>
  <button class="ghbtn" id="csvBtn">Export lines</button>
  <button class="ghbtn ai" id="askTop"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" style="fill:#fff"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8zM19 14l.9 2.6 2.6.9-2.6.9L19 21l-.9-2.6-2.6-.9 2.6-.9z"/></svg>Ask T&amp;E</button>
</header>
<section class="band">
  <div class="crumb" id="crumb">Q3 FY27 · Aug 1 to Oct 31, 2026</div>
  <h1 id="title">Overview</h1>
  <div class="sub" id="subtitle"></div>
  <nav class="tabs" role="tablist" id="tabs" aria-label="Dashboard pages">
    <button role="tab" data-p="overview" aria-selected="true">Overview</button>
    <button role="tab" data-p="insights">Insights</button>
    <button role="tab" data-p="leaders">Leaders</button>
    <button role="tab" data-p="people">Employees</button>
    <button role="tab" data-p="cats">Categories</button>
    <button role="tab" data-p="travel">Travel</button>
    <button role="tab" data-p="ta">Travel approvals &amp; commit</button>
    <button role="tab" data-p="controls">Policy &amp; controls <span class="badge" id="flagBadge"></span></button>
    <button role="tab" data-p="policy">Policy limits</button>
    <button role="tab" data-p="messages">Messages <span class="badge" id="msgBadge"></span></button>
  </nav>
</section>
<section class="fbar" id="fbar" aria-label="Filters">
  <div class="frow">
    <div class="fld"><label for="f_ou">Region</label><select id="f_ou"></select></div>
    <div class="fld"><label for="f_ld">Leader</label><select id="f_ld"></select></div>
    <div class="fld"><label for="f_l1">Leader+1</label><select id="f_l1"></select></div>
    <div class="fld"><label for="f_l2">Leader+2</label><select id="f_l2"></select></div>
    <div class="fld"><label for="f_e">Employee</label><select id="f_e"></select></div>
    <div class="fact"><button class="btn" id="moreBtn" aria-expanded="false" aria-controls="more">More filters</button><button class="btn" id="resetBtn">Reset</button></div>
  </div>
  <div class="frow more" id="more">
    <div class="fld"><label for="f_ow">Budget owner</label><select id="f_ow"></select></div>
    <div class="fld"><label for="f_cat">Category</label><select id="f_cat"></select></div>
    <div class="fld"><label for="f_p">Report purpose</label><select id="f_p"></select></div>
    <div class="fld"><label for="f_s">Approval status</label><select id="f_s"></select></div>
    <div class="fld"><label for="f_q">Search</label><input id="f_q" type="search" placeholder="Name, vendor or city"></div>
  </div>
  <div class="scope" id="scope"></div>
  <div class="kbdhint">Keys: 1–9 change page · / search · Esc closes</div>
</section>
<main id="main">
<section class="page on" id="p-overview">
  <div class="kpis" id="kpis"></div>
  <div class="ai-card" style="margin-bottom:16px">
    <div class="ai-head"><span class="ico" style="background:var(--ai)"><svg viewBox="0 0 24 24"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8z"/></svg></span><h2>What needs attention</h2><span class="chip">Insights from this data</span><span style="flex:1"></span><button class="btn" data-go="insights">See all insights</button></div>
    <div class="ins" id="insTop"></div>
  </div>
  <div class="grid g32">
    <div class="card"><div class="ch"><div><h2>Where the quarter lands</h2><p id="burnSub"></p></div></div>
      <div class="legend" style="margin-top:8px"><span><i style="background:#0176D3"></i>Actual cumulative</span><span><i style="background:#9050E9"></i>Projected</span><span><i style="background:#747474"></i>Even budget pace</span><span><i style="background:#BA0517"></i>Budget</span></div>
      <div class="cb"><div class="chart tall" id="cBurn"></div></div></div>
    <div class="card"><div class="ch"><div><h2>How the forecast is built</h2><p>From spend to date to projected landing.</p></div></div>
      <div class="cb"><div class="chart tall" id="cWater"></div></div>
      <details class="how"><summary>How this is calculated</summary><p id="howForecast"></p></details></div>
  </div>
  <div class="grid g32">
    <div class="card"><div class="ch"><div><h2>Weekly spend by category</h2><p>Fiscal weeks run Sunday to Saturday. Shaded bars are the projection.</p></div></div>
      <div class="legend" id="lgWeekly" style="margin-top:8px"></div><div class="cb"><div class="chart" id="cWeekly"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Region view</h2><p>Spend, budget and projected landing.</p></div></div><div class="cb" id="regions"></div></div>
  </div>
  <div class="card"><div class="ch"><div><h2>Budget owner pacing</h2><p id="ownSub"></p></div></div><div class="cb flush"><div class="tw" id="tOwners"></div></div></div>
  <div class="tie" id="tie-overview"></div>
</section>

<section class="page" id="p-insights">
  <div class="ai-card"><div class="ai-head"><span class="ico" style="background:var(--ai)"><svg viewBox="0 0 24 24"><path d="M12 2l1.8 5.2L19 9l-5.2 1.8L12 16l-1.8-5.2L5 9l5.2-1.8z"/></svg></span><h2>All insights for this view</h2><span class="chip" id="insCount"></span></div>
    <div class="ins full" id="insAll"></div>
    <div class="foot">Insights are recalculated from the lines in the current filter whenever you change it. They come from rules and statistics applied to this data, so check the numbers before acting on them.</div></div>
</section>

<section class="page" id="p-leaders">
  <div class="card" style="margin-bottom:16px"><div class="ch"><div><h2>Leader scorecard</h2><p>One row per leader. The rating dots compare each leader with the others in view.</p></div></div><div class="cb flush"><div class="tw" id="tScore" style="max-height:600px"></div></div></div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Spend by leader</h2><p>Top 15 leaders, split by category.</p></div></div><div class="legend" id="lgLead" style="margin-top:8px"></div><div class="cb"><div class="chart tall" id="cLeaders"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Leader trend</h2><p>Weekly spend for the five largest leaders, to the last complete week.</p></div></div><div class="legend" id="lgLT" style="margin-top:8px"></div><div class="cb"><div class="chart tall" id="cLeadTrend"></div></div></div>
  </div>
  <div class="card" style="margin-bottom:16px"><div class="ch"><div><h2>Org drill-down</h2><p>Leader, then Leader+1, then Leader+2. Select ▸ to expand.</p></div><button class="btn" id="expandAll">Expand all</button></div><div class="cb flush"><div class="tw" id="tTree" style="max-height:640px"></div></div></div>
  <div class="card"><div class="ch"><div><h2>Leader by category</h2><p>Darker cells hold a larger share of that leader's spend.</p></div></div><div class="cb flush"><div class="tw" id="tHeat"></div></div></div>
  <div class="tie" id="tie-leaders"></div>
</section>

<section class="page" id="p-people">
  <div class="stats" id="pStats"></div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Spend concentration</h2><p>Cumulative share of spend by employees ranked from highest.</p></div></div><div class="cb"><div class="chart" id="cPareto"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Employees by spend band</h2><p>How many people fall in each quarter-to-date band.</p></div></div><div class="cb"><div class="chart" id="cBands"></div></div></div>
  </div>
  <div class="card"><div class="ch"><div><h2>Employee spend</h2><p>Select a column to sort. Select a name to focus the whole dashboard on that person. Flagged is the gross value of lines that break a rule.</p></div><input class="tsearch" id="empSearch" type="search" placeholder="Find an employee" aria-label="Find an employee"></div><div class="cb flush"><div class="tw" id="tEmp" style="max-height:640px"></div></div></div>
  <div class="tie" id="tie-people"></div>
</section>

<section class="page" id="p-cats">
  <div class="grid g23">
    <div class="card"><div class="ch"><div><h2>Spend by category</h2><p>Share of spend in view.</p></div></div><div class="cb"><div class="chart" id="cCat"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Category trend</h2><p>Weekly spend by category, to the last complete week.</p></div></div><div class="legend" id="lgCT" style="margin-top:8px"></div><div class="cb"><div class="chart" id="cCatTrend"></div></div></div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Month on month</h2><p>August and September actuals with October projected at the current pace.</p></div></div><div class="cb flush"><div class="tw" id="tMonth"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Spend by report purpose</h2><p id="purpSub"></p></div></div><div class="cb"><div class="chart" id="cPurp"></div></div></div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Customer-facing share by leader</h2><p>Customer-facing travel plus client meals and entertainment.</p></div></div><div class="cb"><div class="chart tall" id="cCust"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Weekday pattern</h2><p>Average spend per calendar day, by day of the week.</p></div></div><div class="cb"><div class="chart tall" id="cDow"></div></div></div>
  </div>
  <div class="card"><div class="ch"><div><h2>Expense types</h2><p>Week change compares the last two complete weeks, leaving out Dreamforce and kickoff spend.</p></div></div><div class="cb flush"><div class="tw" id="tTypes"></div></div></div>
  <div class="tie" id="tie-cats"></div>
</section>

<section class="page" id="p-travel">
  <div class="stats" id="aStats"></div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Booking lead time</h2><p>Tickets by days booked ahead (bars) and average fare (line).</p></div></div><div class="cb"><div class="chart" id="cAdv"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Airfare by route type</h2><p>Spend and average fare.</p></div></div><div class="cb"><div class="chart" id="cScope"></div></div></div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Top routes</h2><p>By airfare spend.</p></div></div><div class="cb flush"><div class="tw" id="tRoutes" style="max-height:420px"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Airlines and travel agency</h2><p>Airfare and booking fees by vendor.</p></div></div><div class="cb"><div class="chart tall" id="cAirline"></div></div></div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Average hotel night by city</h2><p>Top 12 cities by hotel spend. Red bars are above the $300 international cap.</p></div></div><div class="cb"><div class="chart tall" id="cHotel"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Top vendors</h2><p>Spelling variants grouped, for example every Uber or Grab entity.</p></div></div><div class="cb"><div class="chart tall" id="cVendor"></div></div></div>
  </div>
  <div class="card"><div class="ch"><div><h2>Top destinations</h2><p>Spend by expense city, split by category.</p></div></div><div class="legend" id="lgCity" style="margin-top:8px"></div><div class="cb"><div class="chart" id="cCity"></div></div></div>
</section>

<section class="page" id="p-ta">
  <div class="kpis" id="taKpis" style="grid-template-columns:repeat(6,minmax(0,1fr))"></div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>From approvals to open commit</h2><p>What part of the approved travel lands in Q3, and what is still to come.</p></div></div><div class="cb"><div class="chart tall" id="cTaWater"></div></div>
      <details class="how"><summary>How this is calculated</summary><p id="howTa"></p></details></div>
    <div class="card"><div class="ch"><div><h2>Commit by travel week</h2><p>Estimated cost recognised in Q3, by the week the trip happens.</p></div></div>
      <div class="legend" style="margin-top:8px"><span><i style="background:#0176D3"></i>Already incurred (estimate)</span><span><i style="background:#9050E9"></i>Approved, still to come</span><span><i style="background:#D8CBF7"></i>Expected, not yet approved</span></div>
      <div class="cb"><div class="chart tall" id="cTaWeek"></div></div></div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Approved travel by reason</h2><p>Domestic and international estimate.</p></div></div><div class="cb"><div class="chart" id="cTaReason"></div></div></div>
    <div class="card"><div class="ch"><div><h2>How far ahead travel is approved</h2><p>Approvals by days between approval and trip start.</p></div></div><div class="cb"><div class="chart" id="cLead"></div></div></div>
  </div>
  <div class="card" style="margin-bottom:16px"><div class="ch"><div><h2>Commit and accuracy by leader</h2><p>Accuracy compares actual trip spend so far with the approved estimate for the same trip days.</p></div></div><div class="cb flush"><div class="tw" id="tTaLeader"></div></div></div>
  <div class="card"><div class="ch"><div><h2>Travel spend with no approval on file</h2><p>Employees with airfare or hotel spend but no travel approval in the TA sheet.</p></div></div><div class="cb flush"><div class="tw" id="tNoTa"></div></div><div class="foot" id="taFix"></div></div>
</section>

<section class="page" id="p-controls">
  <div class="stats" id="cStats"></div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Policy exceptions by type</h2><p>Spend on lines that break a policy limit. A line can break more than one.</p></div></div><div class="cb"><div class="chart" id="cFlags"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Approval status</h2><p>Where each line sits in the expense workflow.</p></div></div><div class="cb"><div class="chart" id="cStatus"></div></div></div>
  </div>
  <div class="grid g2">
    <div class="card"><div class="ch"><div><h2>Age of unsubmitted spend</h2><p id="agingSub"></p></div></div><div class="cb"><div class="chart short" id="cAging"></div></div></div>
    <div class="card"><div class="ch"><div><h2>Data gaps</h2><p>Items that limit how precisely spend can be attributed.</p></div></div><div class="cb flush" id="dq"></div></div>
  </div>
  <div class="card" style="margin-bottom:16px"><div class="ch"><div><h2>Exceptions by leader</h2><p>Exception rate is flagged spend as a share of the leader's spend.</p></div></div><div class="cb flush"><div class="tw" id="tCtlLeader"></div></div></div>
  <div class="card"><div class="ch"><div><h2>Employees with the most flagged spend</h2><p>Select a name to focus the dashboard on that person.</p></div></div><div class="cb flush"><div class="tw" id="tCtlEmp"></div></div></div>
</section>

<section class="page" id="p-policy"><div class="pol" id="pol"></div></section>

<section class="page" id="p-messages">
  <div id="msgBanner"></div>
  <div class="msgwrap" id="msgWrap" hidden>
    <div class="card msgcol">
      <div class="ch"><div><h2>Recipients</h2><p id="msgCount">Choose who should receive the message.</p></div></div>
      <div class="msgtools">
        <input id="msgQ" type="search" placeholder="Search people" aria-label="Search people">
        <div class="seg" id="msgFilters" role="group" aria-label="Filter recipients">
          <button data-f="all" aria-pressed="true">Everyone</button><button data-f="budget">Budget holders</button><button data-f="managers">Managers</button><button data-f="attention">Needs attention</button>
        </div>
        <div class="msgbtns"><button class="btn" id="selAttn">Select needs attention</button><button class="btn" id="selNone">Clear</button></div>
      </div>
      <div class="rlist" id="rlist"></div>
      <div class="foot">Budget holders show their budget status from their own pacing. A dash means that budget is not visible to you.</div>
    </div>
    <div class="msgmain">
      <div class="card" style="padding:16px 18px">
        <h3 class="sect">1 · Message type</h3>
        <div class="tplgrid" id="tplgrid"></div>
        <h3 class="sect">2 · Optional note</h3>
        <textarea id="msgNote" rows="3" maxlength="500" placeholder="A personal note. It appears at the top of the message." aria-label="Optional note"></textarea>
        <div class="count"><span id="noteCount">0</span>/500</div>
      </div>
      <div class="card" style="padding:16px 18px;margin-top:14px">
        <div class="prevhead"><h3 class="sect">3 · Preview</h3><div class="pnav"><button id="pPrev" aria-label="Previous sample">‹</button><span id="pIdx"></span><button id="pNext" aria-label="Next sample">›</button></div></div>
        <div id="preview"><div class="empty">Select recipients to see exactly what each one will receive.</div></div>
      </div>
      <div class="sendbar"><div class="hint" id="sendHint"></div><button class="btn brand" id="sendBtn" disabled>Review and send</button></div>
      <div class="card" style="padding:0">
        <div class="ch" style="padding:14px 16px 0"><div><h2>Sent messages</h2><p>Admins see everyone's. Everyone else sees their own.</p></div></div>
        <div class="cb flush"><div class="tw" id="msgLog" style="max-height:340px"></div></div>
